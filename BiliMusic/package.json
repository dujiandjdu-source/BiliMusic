{
  "name": "bili-music",
  "private": true,
  "version": "1.2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && npm test && vite build",
    "test": "node --test tools/tests/*.test.cjs",
    "check:bili": "electron tools/check-bilibili.cjs",
    "qmc:decode": "node tools/decode-qmc.cjs",
    "pack": "npm run check && electron-builder --win --x64",
    "pack:portable": "npm run check && electron-builder --win portable --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clamber_l/crypto": "^0.1.12",
    "@react-spring/web": "^10.0.3",
    "colorthief": "^3.3.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "jsmediatags": "^3.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.5.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.bilimusic.app",
    "productName": "BiliMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "dujiandjdu-source",
      "repo": "BiliMusic"
    }
  }
}
